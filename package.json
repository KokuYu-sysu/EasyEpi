{
  "name": "easyepi",
  "productName": "EasyEpi",
  "version": "0.2.0",
  "description": "Offline questionnaire design and field data collection for epidemiological research",
  "author": "KokuYu-EasyEpi Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "install:electron": "install-electron",
    "generate:icon": "node scripts/generate-icon.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test tests/e2e/app.spec.ts",
    "test:e2e:packaged": "playwright test tests/e2e/packaged.spec.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "build:win": "pnpm build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.19",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-radio-group": "1.4.3",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-toast": "1.2.19",
    "@radix-ui/react-tooltip": "1.2.12",
    "lucide-react": "1.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.0",
    "tailwindcss": "4.3.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.5",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
